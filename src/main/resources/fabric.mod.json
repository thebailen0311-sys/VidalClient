    "issues": "https://github.com/thebailen0311-sys/VidalClient/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": ["com.trace.refract.Refract"]
  },
  "mixins": ["refract.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.11",
    "java": ">=21",
